{
  "extends": "./tsconfig.base.json",
  "include": ["web", "shared"],

  // Including `web/vite.config.ts` would pull in Node's types, so it's checked
  // by `tsconfig.tooling.json` instead.
  "exclude": ["web/dist", "web/vite.config.ts"],

  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["vite-plugin-pwa/client", "vite/client"],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
