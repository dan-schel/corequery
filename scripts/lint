#!/usr/bin/env bash

set -euo pipefail

npx tsc -p tsconfig.server.json --noEmit
npx tsc -p tsconfig.web.json --noEmit
npx tsc -p tsconfig.tooling.json --noEmit
npx tsc -p tsconfig.generate-pwa-assets.json --noEmit

if [[ "${1:-}" == "--fix" ]]; then
  npx eslint . --max-warnings 0 --fix
else
  npx eslint . --max-warnings 0
fi

npx knip
